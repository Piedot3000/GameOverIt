# Copy to .env and fill in. .env is git-ignored; this file is committed.
# On a deployed host, set these in the dashboard instead: there is no .env there.

# Local (page 4):    postgresql://postgres:***@localhost:5432/gameoverit
# Hosted (page 5):   postgresql://user:***@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:***@localhost:5432/gameoverit

# Comma-separated, no trailing slash, no path. An origin is scheme + host + port.
CORS_ORIGINS=http://localhost:5173

# Set to production on your host. Express and several libraries behave better,
# including not sending stack traces to your users.
NODE_ENV=development

# Optional. Without it the Steam features return 503 with code "UNCONFIGURED",
# and everything else keeps working. Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Do NOT set PORT locally or on the host. The host sets it for you.
